    "db:push": "drizzle-kit push",
    "db:conn-test": "tsx scripts/db-conn-test.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:candidates": "tsx src/db/seed-candidates.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "drizzle-kit drop && npm run db:migrate && npm run db:seed",
    "enrich": "npx tsx scripts/enrich.ts",
    "enrich:articles": "npx tsx scripts/enrich-articles.ts",
    "enrich:batch": "npx tsx scripts/enrich.ts --batch",
    "enrich:articles:batch": "npx tsx scripts/enrich-articles.ts --batch",
