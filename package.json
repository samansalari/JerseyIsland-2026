{
  "name": "votepulse",
  "version": "0.1.0",
  "private": true,
  "description": "VotePulse — public election intelligence for Jersey's 2026 general election",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
