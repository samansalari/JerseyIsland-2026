    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "ioredis": "^5.10.1",
    "motion": "^12.38.0",
    "next": "^15.0.7",
    "node-cron": "^3.0.3",
    "postcss": "^8.5.10",
    "postgres": "^3.4.5",
    "react": "19.0.0-rc-66855b96-20241106",
    "react-dom": "19.0.0-rc-66855b96-20241106",
    "react-markdown": "^10.1.0",
    "resend": "^6.12.2",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.0.7",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
