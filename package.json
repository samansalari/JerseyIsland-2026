    "seed": "npx tsx scripts/seed-candidates.ts",
    "pages:build": "npx @cloudflare/next-on-pages@1",
    "pages:dev": "npx wrangler pages dev .vercel/output/static",
    "validate:social": "npx tsx scripts/validate-social-links.ts",
    "seed:topics": "npx tsx scripts/seed-topics.ts",
    "generate:topics": "npx tsx scripts/generate-topics.ts",
    "fix:ai-issues": "npx tsx scripts/fix-ai-issues.ts",
    "clean:candidates": "npx tsx scripts/clean-candidates.ts",
