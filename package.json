    "import:local": "npx tsx scripts/import-local-scrapes.ts",
    "seed:candidates": "npx tsx scripts/seed-candidates.ts",
    "scrape:flow": "tsx scripts/scrapers/scrape-flow-je.ts",
    "scrape:vote": "tsx scripts/scrapers/scrape-vote-je.ts",
    "scrape:manifestos": "npx tsx scripts/scrapers/scrape-vote-je-manifestos.ts",
    "extract:social": "npx tsx scripts/extract-social-links.ts",
    "ingest:news": "tsx scripts/ingest-news.ts",
