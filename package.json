{
  "name": "votepulse",
  "version": "0.1.0",
  "private": true,
  "description": "VotePulse — public election intelligence for Jersey's 2026 general election",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:kit": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:conn-test": "tsx scripts/db-conn-test.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:candidates": "tsx src/db/seed-candidates.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "drizzle-kit drop && npm run db:migrate && npm run db:seed",
    "enrich": "tsx scripts/enrich.ts",
    "enrich:articles": "tsx scripts/enrich-articles.ts",
    "seed:candidates": "tsx scripts/seed-candidates.ts",
    "scrape:flow": "tsx scripts/scrapers/scrape-flow-je.ts",
    "scrape:vote": "tsx scripts/scrapers/scrape-vote-je.ts",
    "ingest:news": "tsx scripts/ingest-news.ts",
    "import:local-scrapes": "tsx scripts/import-local-scrapes.ts",
    "cron": "tsx scripts/cron.ts",
    "seed": "tsx scripts/seed-candidates.ts",
    "pages:build": "npx @cloudflare/next-on-pages@1",
    "pages:dev": "npx wrangler pages dev .vercel/output/static"
