# =========================
# Supabase (browser + SSR session refresh)
# =========================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use publishable key from the dashboard, or the legacy anon JWT:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =========================
# Admin UI (/admin) — cookie auth
# =========================
ADMIN_SECRET=choose-a-long-random-string

# Pooler (app / serverless) — Supabase “Transaction pooler” URI, port 6543.
# Username is often `postgres.<project-ref>` (see Supabase Dashboard → Connect).
# `npm run db:push` loads `.env.local` via `load-env.ts`.
# If you see `28P01 password authentication failed`, reset the DB password in the
# dashboard and paste the Connect strings again — run `npm run db:conn-test` to see which URL works.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# (Pooler host may be aws-1-… — use the exact string from Supabase → Connect.)

# URL for `npm run db:push` (see `drizzle.config.ts`). Optional for the Next.js app.
#
# Supabase “Direct connection” (Dashboard → Connect) matches:
#   postgresql://postgres:[password]@db.<project-ref>.supabase.co:5432/postgres
# The dashboard warns this is NOT IPv4-compatible unless you purchase the IPv4
# add-on; on IPv4-only networks use the pooler instead (below).
#
# For drizzle-kit on Windows / typical home IPv4: set DIRECT_URL to the
# “Session pooler” URI (port 5432, user `postgres.<project-ref>`), not `db.*`.
# Session pooler: port 5432, user postgres.<project-ref>, host aws-0- or aws-1-<region>.pooler.supabase.com
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres

# Optional: force `npm run db:push` to use this URL only (same as a working DIRECT_URL / session pooler).
# Use if DIRECT_URL is the direct `db.*` host (IPv6) but you keep it for other tools.
# DRIZZLE_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# =========================
# AI Enrichment (xAI Grok — OpenAI-compatible Chat Completions)
# =========================
# Console: https://console.x.ai — use either name; scripts accept both.
GROK_API_KEY=xai-...
# Optional; default in scripts is grok-2-latest (see xAI model list).
GROK_MODEL=grok-2-latest
# XAI_API_KEY=xai-...

# =========================
# Scraping
# =========================
FIRECRAWL_API_KEY=fc-...
FIRECRAWL_DAILY_CREDIT_LIMIT=500

# =========================
# App
# =========================
NEXT_PUBLIC_SITE_URL=https://votepulse.je
NODE_ENV=production

# Skip DB ping during CI/bootstrap when DATABASE_URL is not wired yet
SKIP_DB_HEALTHCHECK=false

# =========================
# ISR Revalidation
# =========================
REVALIDATION_SECRET=generate-a-random-string-here

# =========================
# Email (Resend)
# =========================
# Dashboard: https://resend.com/api-keys — use a key with "Sending access".
RESEND_API_KEY=re_...
